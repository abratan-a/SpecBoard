            "value" : "大きさは幅 %lld〜%lld マス、高さ %lld〜%lld マスです（%@ ではなく）"
          }
        }
      }
    },
    "error.unknownPlace" : {
      "comment" : "Problem when the rules name places the app does not know; arguments are the unknown places and the known ones.",
