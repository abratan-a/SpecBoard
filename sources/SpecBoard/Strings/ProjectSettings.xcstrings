    "rules.intro" : {
      "comment" : "Explanation under the title of the writing rules tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For each place, decide what to write in the free-text descriptions (description). Places without a rule use the rule of a broader place or the app's default (faint text). Before writing, an AI reads this with MCP's project_read (value as: rules)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自由に書く説明（description）に何を書くかを、書く場所ごとに決めます。決めていない場所は、広い場所の決まりかアプリの既定（薄い字）を使います。AI は書く前に MCP の project_read（value の as: rules）でこれを読みます"
          }
        }
      }
    },
