    "lock.aiMergeExplanation" : {
      "comment" : "Explanation under the switch for AI merges into a locked main.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When an AI merges into main, it goes in as it is, without an MR. Each time, a bubble from the bell in the header tells who merged which branch (it also stays in the bell's list and in the history). Into a main that is not locked, merges always go in without approval. This is the only place to change it (MCP can only read it)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI が main へ merge すると、MR を出さずにそのまま入ります。入るたびに、ヘッダーのベルから出る吹き出しで誰がどの branch を入れたかを知らせます（ベルの一覧と履歴にも残ります）。ロックしていない main へは、もとから承認なしで入ります。変えられるのはここだけです（MCP からは読むだけ）"
          }
        }
      }
    },
    "lock.aiMergeLabel" : {
      "comment" : "Label of the switch that lets an AI's merges into a locked main go in without an MR.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Let AI merges go into main without approval, even while locked"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック中も、AI の merge を承認なしで main に入れる"
          }
        }
      }
    },
    "lock.explanation" : {
      "comment" : "Explanation under the switch that locks main.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "While locked, main can only be changed by a merge (from the screen or from MCP). Change cards and sections in a branch and merge it, or use “Batch edit” (when closed, it goes into main as a single merge). When an AI merges into main, it becomes an MR that a person approves in the MR tab of the dashboard. Still editable while locked: the position and order of cards inside a section, the size and look of writing cards, the position of flow nodes, tags, and the project settings. You can also lock and unlock with a right-click on main in the Navigator."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック中は、main を merge でしか変えられません（画面からも MCP からも）。カードとセクションは branch で直して merge するか、「まとめて直す」で直します（閉じると 1 つの merge として main に入ります）。AI が main へ merge するとMR になり、人がダッシュボードの MR のタブで承認します。ロック中も直せるのは、セクションの中のカードの位置と並び・書くカードの大きさと見え方・flow のノードの位置・タグ・プロジェクトの設定です。ナビパネルの main の右クリックでも掛け外しできます"
          }
        }
      }
    },
    "lock.title" : {
      "comment" : "Heading of main's lock setting on the project tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lock on main"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "main のロック"
          }
        }
      }
    },
    "lock.toggle" : {
      "comment" : "Label of the switch that locks main.",
      "extractionState" : "manual",
      "localizations" : {
