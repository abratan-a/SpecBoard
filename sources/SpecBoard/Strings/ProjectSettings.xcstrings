      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A setting of the project as a whole; it does not change per branch. A person can edit it even while main is locked."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトに 1 つの設定で、branch では変わりません。main がロック中でも人は直せます"
          }
        }
      }
    },
