{
  "sourceLanguage" : "en",
  "strings" : {
    "default.cardDescription" : {
      "comment" : "The app's rule for what to write in a card's description.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Say what the card is in the first sentence, then write the rules that hold for the whole card. Put long reasons and background in a note and point to it with [[ ]] (for one in another section, write the section too, or place a card ghost in this section so the name alone works)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最初の一文でそのカードが何かを言い、続けてカード全体にかかる決まりを書く。長い理由や経緯は note に書いて [[ ]] で指す（ほかのセクションのものは、セクションを付けて書くか、そのセクションにカードゴーストを置けば名前だけで書ける）"
          }
        }
      }
    },
    "default.documentBody" : {
      "comment" : "The app's rule for what to write in the body of a design or specification document.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The body of a design or specification document: rules that span several cards, and the reasons and background of the design. Point to the cards concerned with [[ ]] (for one in another section, write the section too, or place a card ghost in this section so the name alone works). Do not write in prose what the fields of rules and absentFields, or lines (connections), can say"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設計書・仕様書の本文: 複数のカードにまたがる決まり、設計の理由と経緯。関係するカードを [[ ]] で指す（ほかのセクションのものは、セクションを付けて書くか、そのセクションにカードゴーストを置けば名前だけで書ける）。rules・absentFields の欄や線（connections）で書けることは文章にしない"
          }
        }
      }
    },
    "default.fieldDescription" : {
      "comment" : "The app's rule for what to write in a field's description.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The rules of that value (format, unit, range, what empty or null means, notes on what it points to). Why it is so, and rules that span other cards, go in a note"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その値の決まり（形式・単位・範囲、空や null の意味、指し先の補足）。なぜそうしたか・ほかのカードにまたがる決まりは note に"
          }
        }
      }
    },
    "default.nodeDescription" : {
      "comment" : "The app's rule for what to write in a flow node's description.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A supplement for that node only"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのノードだけの補足"
          }
        }
      }
    },
    "default.noteBody" : {
      "comment" : "The app's rule for what to write in a note's body.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memos, change history and open questions (sticky notes) about the cards beside it. Point to the cards concerned with [[ ]] (for one in another section, write the section too, or place a card ghost in this section so the name alone works)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのそばのカードについてのメモ・変更履歴・未決の問い（付箋）。関係するカードを [[ ]] で指す（ほかのセクションのものは、セクションを付けて書くか、そのセクションにカードゴーストを置けば名前だけで書ける）"
          }
        }
      }
    },
    "default.projectDescription" : {
      "comment" : "The app's rule for what to write in a project's description.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the project is, how its sections are divided, and where to start reading (the map of the project). Write each individual rule at its own place"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何のプロジェクトか、セクションの分け方、どこから読むか（プロジェクトの地図）。個々の決まりはそれぞれの場所に書く"
          }
        }
      }
    },
    "default.sectionDescription" : {
      "comment" : "The app's rule for what to write in a section's description.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What the section (a part) is responsible for, and where it ends and other sections begin"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そのセクション（部品）が受け持つことと、ほかのセクションとの境目"
          }
        }
      }
    },
    "default.stepDescription" : {
      "comment" : "The app's rule for what to write in the description of a row of a flow's processing node.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A supplement for that row (trigger, route) only"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その行（きっかけ・道）だけの補足"
          }
        }
      }
    },
