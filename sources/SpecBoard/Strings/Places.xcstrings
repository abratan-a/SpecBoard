            "value" : "Take %@ out of the hub?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ をハブから外しますか？"
          }
        }
      }
    },
    "hubSettings.removeMessage" : {
      "comment" : "A hub's settings: message of the confirmation before removing the hub from the list.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub keeps running on its host and its agents stay in it. Only this app stops showing it."
          }
        },
        "ja" : {
          "stringUnit" : {
