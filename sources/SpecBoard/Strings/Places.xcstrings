    },
    "localAgent.about" : {
      "comment" : "Explanation at the top of This Mac's local agent settings. The argument is the agent's home as it is said (~/.specboard).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs the agent bundled with this app for your user on this Mac (under %@), without SSH. While it is on, the agent keeps this Mac's projects and receives MCP on this Mac's 127.0.0.1, so AI sessions on this Mac can read and write them with an access key. The agent keeps running after SpecBoard quits."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリに入っているエージェントを、SSH を使わずに、この Mac のあなたの利用者（%@）で動かします。入れている間は、エージェントがこの Mac のプロジェクトを持ち、この Mac の 127.0.0.1 で MCP を受けるので、この Mac の AI のセッションがアクセスキーで読み書きできます。エージェントは SpecBoard を閉じても動き続けます。"
          }
        }
      }
    },
