{
  "sourceLanguage" : "en",
  "strings" : {
    "addForm.note" : {
      "comment" : "Explanation in the popover that adds an agent.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH destination (user@host or a name from ~/.ssh/config). It connects with this Mac's SSH settings and keys."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH の接続先（user@host か ~/.ssh/config の名前）。この Mac の SSH の設定と鍵で繋ぎます。"
          }
        }
      }
    },
    "addHubForm.note" : {
      "comment" : "Explanation in the popover that adds a hub.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub runs as a user of its own on a host that stays up (for example sbhub@host). It opens no network port: agents reach it over SSH with a key that can do nothing else."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブは、起きたままのホストの専用の利用者で動かします（例: sbhub@host）。ネットワークに口を開けず、エージェントは、ほかに何もできない鍵で SSH から繋ぎます。"
          }
        }
      }
    },
    "agent.linuxLabel" : {
      "comment" : "Name of the kind of host an agent is carried for, used inside a failure message.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linux (x86_64)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linux（x86_64）"
          }
        }
      }
    },
    "away.notYet" : {
      "comment" : "Notice in an agent's keys and public tabs while it is not connected.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This agent isn't connected yet"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエージェントには、まだ繋がっていません"
          }
        }
      }
    },
    "away.why" : {
      "comment" : "Explanation under the not-connected notice.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub, access keys and public settings are kept in the agent itself, so they can be seen only while it is connected (connect under \"Connection\")"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブ・アクセスキー・公開は、エージェントの本体に置いているので、繋がっている間だけ見られます（接続は「接続」で）"
          }
        }
      }
    },
    "column.addAgent" : {
      "comment" : "Button under the list of places, and the title of the form it opens.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add agent"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントを追加"
          }
        }
      }
    },
    "column.addAgentHelp" : {
      "comment" : "Tooltip of the Add agent button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add an SSH destination to put an agent there and start it. The agent keeps projects on that host."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SSH の接続先を足すと、そこにエージェントを置いて起こします。エージェントはそこでプロジェクトを持ちます"
          }
        }
      }
    },
    "column.addHub" : {
      "comment" : "Button under the list of places, and the title of the form it opens.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add hub"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブを追加"
          }
        }
      }
    },
    "column.addHubHelp" : {
      "comment" : "Tooltip of the Add hub button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add the SSH destination of the user the hub runs as. The hub is put there and started. It keeps no projects: it passes requests between your agents."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブを動かす利用者の SSH の接続先を足すと、そこにハブを置いて起こします。ハブはプロジェクトを持たず、エージェントどうしの頼みを渡します"
          }
        }
      }
    },
    "connection.about" : {
      "comment" : "Explanation at the top of an agent's connection tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connects to this host over SSH, puts the agent bundled with this app there and starts it (under ~/.specboard/agent on the host; nothing needs to be set up on the host). The agent receives MCP on the host's 127.0.0.1 and answers for the host's projects."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストへ SSH で繋ぎ、このアプリに入っているエージェントを置いて起こします（ホストの ~/.specboard/agent の下。ホストの設定は要りません）。エージェントはそのホストの 127.0.0.1 で MCP を受け、そのホストのプロジェクトに答えます。"
          }
        }
      }
    },
    "connection.claudeMissing" : {
      "comment" : "Badge that says no Claude Code was found on the host.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude not found"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude が見つからない"
          }
        }
      }
    },
    "connection.nameHelp" : {
      "comment" : "Tooltip of the name field in an agent's connection tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent name (shown in lists and move destinations; the destination if empty)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントの名前（一覧や移す先に出ます。空なら接続先）"
          }
        }
      }
    },
    "connection.notReached" : {
      "comment" : "Line shown when the host cannot be reached and gave no reason.",
