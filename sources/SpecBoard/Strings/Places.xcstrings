    "publish.about" : {
      "comment" : "Explanation at the top of a place's public tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Public projects can be read with any access key (only keys allowed “Read & write” can write). Private projects can be read only by the keys allowed in the access key's settings. New projects start private. In the app, both look the same and can be edited."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開のプロジェクトは、どのアクセスキーからも読めます（書けるのは「読み書き」を許したキーだけ）。非公開のプロジェクトは、アクセスキーの設定で許したキーだけが読めます。新しいプロジェクトは非公開で始まります。画面からは、どちらも同じように見えて直せます。"
