    "thisMac.where" : {
      "comment" : "Explanation under the notice in the settings of This Mac.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP is received by the agent on the host where the AI session runs, and answers for that agent's projects. To let an AI read a project, move it to an agent with “Move to an agent” in the row's context menu. Access keys and public settings are under the gear of the agent in the list on the left."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP は、AI のセッションが動くホストのエージェントが受け、そのエージェントのプロジェクトに答えます。AI に読ませるプロジェクトは、行の右クリック「エージェントへ移す」でエージェントへ移します。アクセスキーと公開は、左の一覧のエージェントの ⚙ にあります。"
          }
        }
      }
