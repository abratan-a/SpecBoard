    "connection.portNote" : {
      "comment" : "Explanation under the MCP port field in an agent's connection tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The port that the AI sessions of this user on this host connect to (127.0.0.1). Use a different port for each user."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストの、この利用者の AI のセッションが繋ぐポート（127.0.0.1）。利用者ごとに別のポートにします。"
          }
        }
      }
    },
    "connection.probeNow" : {
      "comment" : "Button that probes the host at once.",
