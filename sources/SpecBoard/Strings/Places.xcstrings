    "hubSettings.removeMemberMessage" : {
      "comment" : "A hub's settings: message of the confirmation before taking an agent out of the hub.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its key is removed from the hub, so its agent can no longer connect. An agent this app is connected to also lets go of its own key and of what it kept of the hub. One that is not connected now keeps them: take it out later from the agent's own settings (Hub tab)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブから鍵を消すので、そのエージェントは繋げなくなります。このアプリが繋がっているエージェントは、自分の鍵とハブの控えも片付けます。今繋がっていないエージェントには残るので、あとでそのエージェントの設定（「ハブ」のタブ）から外してください。"
          }
        }
      }
    },
    "hubSettings.removeMemberTitle" : {
