    "hub.about" : {
      "comment" : "The 'Hub' tab of an agent's settings: what the tab is for.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share this agent's projects with your other agents through the hub, and use the projects they share. The projects stay with the agent that has them: the hub only passes requests on. The AI sessions here use shared projects with this agent's own access keys."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエージェントのプロジェクトを、ハブを通してほかのエージェントと共有し、ほかのエージェントが共有しているプロジェクトを使います。プロジェクトは持っているエージェントに置いたままで、ハブは頼みを渡すだけです。ここの AI のセッションは、共有されたプロジェクトを、このエージェントのアクセスキーで使います。"
          }
        }
      }
    },
    "hub.afterJoin" : {
      "comment" : "The 'Hub' tab of an agent's settings: shown under the form that joins the agent to a hub.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared projects appear here once this agent is in the hub."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブに加えると、共有するプロジェクトと、共有されているプロジェクトがここに並びます。"
          }
        }
      }
    },
    "hub.down" : {
      "comment" : "The 'Hub' tab of an agent's settings: the link to the hub dropped; the arguments are the time, why, and the seconds until it is tried again.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
