    "hubSettings.about" : {
      "comment" : "A hub's settings: what a hub is.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The hub passes requests between your agents. It keeps no projects: only who is in it and how to reach them. It runs as its own user on a host that stays up, and listens on no network port: agents reach it over SSH with a key that can do nothing else."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ハブは、エージェントどうしの頼みを渡します。プロジェクトは持たず、誰が加わっているかと、渡し方だけを持ちます。起きたままのホストの専用の利用者で動き、ネットワークに口を開けません。エージェントは、ほかに何もできない鍵で SSH から繋ぎます。"
          }
        }
      }
    },
    "hubSettings.addNote" : {
      "comment" : "A hub's settings: note under the agents: where an agent is added from.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add an agent from its own settings (Hub tab)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントは、そのエージェントの設定（「ハブ」のタブ）から加えます。"
          }
        }
      }
    },
    "hubSettings.agents" : {
