    "hub.joinNote" : {
      "comment" : "The 'Hub' tab of an agent's settings: explanation of what joining does.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joining makes a key on this host that can only connect to the hub, and adds it to the hub. Nothing else on either host is given access."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加えると、このホストに、ハブへ繋ぐことしかできない鍵を作り、ハブに足します。どちらのホストにも、ほかのものへのアクセスは渡しません。"
          }
        }
      }
    },
    "hub.keysNote" : {
      "comment" : "The 'Hub' tab of an agent's settings: note under the projects shared with the agent.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which access keys may use them is set in Access keys. A shared project can be used only as far as both the share and the key allow."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのアクセスキーで使えるかは「アクセスキー」で決めます。共有されたプロジェクトは、共有とキーの許可の両方が許す範囲でだけ使えます。"
          }
        }
      }
    },
