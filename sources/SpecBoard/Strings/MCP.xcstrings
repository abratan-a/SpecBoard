    "keys.created" : {
      "comment" : "Panel shown right after a key is made; the argument is the key's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Created “%@”. The key can't be shown again once you leave this page (if you need it, “Regenerate…” makes a new value). Next, choose below which projects this key may touch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」を作りました。キーはこのページを離れると二度と出せません（要るなら「作り直す…」で値を作り直せます）。次に、下でこのキーに触れてよいプロジェクトを選びます。"
          }
        }
      }
    },
    "keys.createdOn" : {
      "comment" : "Line in the key list; the argument is a date and time.",
