{
  "sourceLanguage" : "en",
  "strings" : {
    "ask.always" : {
      "comment" : "Sentence in the permission request; the argument is the list of what they change.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Always allow” and “Always deny” change %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常に許可・常に拒否は、%@を変えます"
          }
        }
      }
    },
    "ask.alwaysJoin" : {
      "comment" : "Joins the things Always allow and Always deny change.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ", and "
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "と"
          }
        }
      }
    },
    "ask.alwaysKey" : {
      "comment" : "What Always allow and Always deny change, for an item of a key; the argument is the key's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the settings of access key “%@”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスキー「%@」の設定"
          }
        }
      }
    },
    "ask.alwaysProject" : {
      "comment" : "What Always allow and Always deny change, for an item of a project; the argument is the project as the request names it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the settings of %@, which apply to every access key"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の設定（どのアクセスキーにも効く）"
          }
        }
      }
    },
    "ask.alwaysTimeout" : {
      "comment" : "Last line of the permission request; the arguments are the sentence about Always allow and the minutes to answer.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. If there is no answer in %lld min, it is withdrawn."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。%lld 分で答えが無ければ取り下げます。"
          }
        }
      }
    },
    "ask.answerAlways" : {
      "comment" : "Button that allows the call and sets the item to Allow.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always allow"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常に許可"
          }
        }
      }
    },
    "ask.answerNever" : {
      "comment" : "Button that denies the call and sets the item to Deny.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Always deny"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常に拒否"
          }
        }
      }
    },
    "ask.answerOnce" : {
      "comment" : "Button that allows only the one call that asked.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow once"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今回だけ許可"
          }
        }
      }
    },
    "ask.calling" : {
      "comment" : "First line of the permission request; the arguments are the access key's name and the tool.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Access key “%@” is calling %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスキー「%@」が %@ を呼んでいます。"
          }
        }
      }
    },
    "ask.errorMainThread" : {
      "comment" : "Error returned to the core when a permission request is made on the main thread.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't ask for permission from the main thread"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面のスレッドからは許可を求められません"
          }
        }
      }
    },
    "ask.errorUnreadable" : {
      "comment" : "Error returned to the core when a permission request cannot be read.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't read the permission request"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可の求めが読めません"
          }
        }
      }
    },
    "ask.more" : {
      "comment" : "Heading of the permission request when others wait; the argument is how many.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld more"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほか %lld 件"
          }
        }
      }
    },
    "ask.panelTitle" : {
