    "settings.fromAgents" : {
      "comment" : "Switch in the MCP settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accept screen operations from agents"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントからの画面の操作を受ける"
          }
        }
      }
    },
    "settings.fromAgentsNote" : {
      "comment" : "Explanation under the switch in the MCP settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This window accepts app_control of the MCP that each connected agent receives itself (read, select and capture the screen). It works only while an agent's project is open, and only for projects its access key can read. When this is off, agents can't see this window."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "繋いでいるエージェントが自分で受ける MCP の app_control（画面を読む・選ぶ・撮る）を、この窓で受けます。エージェントのプロジェクトを開いているときだけで、そのアクセスキーで読めるプロジェクトに限ります。切ると、エージェントにはこの窓が見えません。"
          }
        }
      }
    },
    "settings.intro" : {
      "comment" : "Explanation at the top of the MCP page of the app's settings.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP is received by the agent on the host where the AI session runs, on that host's 127.0.0.1, and answers for that agent's projects. The app itself listens for nothing, so MCP doesn't reach this Mac's projects (to let an AI read a project, move it to an agent). Connecting needs that agent's access key; make keys under “Access keys” in a place's settings in the project list."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP は、AI のセッションが動くホストのエージェントが、そのホストの 127.0.0.1 で受け、そのエージェントのプロジェクトに答えます。アプリ自身は何も待ち受けないので、この Mac のプロジェクトには MCP が届きません（AI に読ませるときはエージェントへ移します）。繋ぐにはそのエージェントのアクセスキーが要り、キーはプロジェクト一覧の場所の設定の「アクセスキー」で作ります。"
          }
        }
      }
    },
    "settings.registerNote" : {
      "comment" : "Line beside the button that goes to the access keys.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The registration command appears when you create a key."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登録のコマンドは、キーを作ると出ます。"
          }
        }
      }
    },
    "settings.toKeys" : {
      "comment" : "Button that goes to the access keys.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Go to access keys"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクセスキーへ"
          }
        }
      }
    },
