    },
    "keys.hideCommand" : {
      "comment" : "Button in the made-key panel that hides the registration command.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hide registration command"
          }
