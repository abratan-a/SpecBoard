          }
        }
      }
    },
    "keys.intro" : {
      "comment" : "Explanation at the top of the access keys page.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To connect over MCP, you need an access key on the host where the agent runs. Make one key for each development session (project) and decide which projects it may touch. Public projects can be read with any key."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP で繋ぐには、エージェントを置いたホストでアクセスキーが要ります。開発のセッション（プロジェクト）ごとに 1 本作り、触れるプロジェクトを決めます。公開のプロジェクトは、どのキーからも読めます。"
          }
        }
      }
    },
    "keys.lastUsed" : {
      "comment" : "Line in the key list; the argument is a date and time.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last used %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後に使った %@"
          }
        }
      }
    },
    "keys.levelRead" : {
      "comment" : "Choice of a key's access to a project: it may read.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読む"
          }
        }
      }
    },
    "keys.levelWrite" : {
