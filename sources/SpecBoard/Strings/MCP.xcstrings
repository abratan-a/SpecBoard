    "keys.permitCapture" : {
      "comment" : "Label of the permission that lets a key capture the app's screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a picture of the screen (app_control capture)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面を撮る（app_control の capture）"
          }
        }
      }
    },
    "keys.permitControl" : {
      "comment" : "Label of the permission that lets a key drive the app's screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the screen and change how it looks (app_control state, select, view, windows)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面を選ぶ・見え方を変える（app_control の state・select・view・windows）"
          }
        }
      }
    },
    "keys.permitCreate" : {
      "comment" : "Label of the permission that lets a key create projects.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create projects (project_create)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトを作る（project_create）"
          }
        }
      }
    },
    "keys.placeNote" : {
      "comment" : "Note under the explanation on the access keys page; the argument is the agent's MCP port.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keys for this agent's projects. The AI on that host connects with one of these keys to the MCP the agent receives itself (127.0.0.1:%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このエージェントのプロジェクトのキー。そのホストの AI は、エージェントが自分で受ける MCP（127.0.0.1:%@）に、このキーで繋ぎます。"
          }
        }
      }
    },
    "keys.projectsNote" : {
      "comment" : "Note under the project-creation permission in the key's detail.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projects it creates can be read and written with this key. Which writing tools MCP may use inside a project is decided per project in the “MCP” tab of Project Settings."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作ったプロジェクトは、このキーで読み書きできます。プロジェクトの中で MCP が使ってよい書くツールは、プロジェクトごとにプロジェクト設定の「MCP」のタブで決めます。"
          }
        }
      }
    },
    "keys.publicNote" : {
      "comment" : "Small label beside a public project in the per-project permissions.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Public (readable even with None)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開（なしでも読める）"
          }
        }
      }
    },
    "keys.regenerate" : {
      "comment" : "Destructive button of the regenerate dialog.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regenerate"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作り直す"
          }
        }
      }
    },
    "keys.regenerateButton" : {
      "comment" : "Button that opens the regenerate dialog for the chosen key.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regenerate…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作り直す…"
          }
        }
      }
    },
    "keys.regenerateHelp" : {
      "comment" : "Tooltip of the Regenerate button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the key's value is renewed; its name, permissions and projects stay the same (the current value stops working)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前・許可・プロジェクトはそのままで、キーの値だけを新しくします（今の値は使えなくなります）"
          }
        }
      }
    },
    "keys.regenerateMessage" : {
      "comment" : "Message of the dialog that asks whether to make an access key's value again.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only the key's value is renewed; its name, permissions and projects stay the same. Sessions connected with the current value will be refused from their next request, so replace the key wherever it is registered. This can't be undone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前・許可・プロジェクトはそのままで、キーの値だけを新しくします。今の値で繋いでいるセッションは次の要求から断られるので、登録しているところを新しいキーに替えます。元には戻せません。"
          }
        }
      }
    },
    "keys.regenerateTitle" : {
      "comment" : "Title of the dialog that asks whether to make an access key's value again; the argument is the key's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regenerate the key of “%@”?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」のキーを作り直しますか？"
          }
        }
      }
    },
    "keys.regenerated" : {
      "comment" : "Panel shown right after a key's value was made again; the argument is the key's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The key “%@” was regenerated. The previous value no longer works. The new key can't be shown again once you leave this page either. Replace the key where it is registered (the AI session's settings, wherever the key is stored)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」のキーを作り直しました。前の値はもう使えません。新しいキーもこのページを離れると二度と出せません。登録しているところ（AI のセッションの設定・キーの置き場）を新しいキーに替えます。"
          }
        }
      }
    },
