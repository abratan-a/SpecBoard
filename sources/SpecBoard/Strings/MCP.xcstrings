      }
    },
    "writes.groupHelp" : {
      "comment" : "Tooltip of a group's permission choice; the argument is the group's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set every item of %@ to the same state"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の項目を全部同じにする"
          }
        }
      }
    },
    "writes.intro" : {
      "comment" : "Explanation at the top of the project settings' MCP tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For each tool that writes in this project, choose whether MCP (an AI) may use it: Allow, Ask each time or Deny. “Ask each time” asks for permission on the screen when the call carries request: true (without it, the call is refused). “Deny” refuses without writing anything (a batch is judged step by step). An AI can read the items set to “Ask each time” and “Deny” with project_read, but only a person can change them. They don't apply to writes from the screen. Which projects a key can read and write, and whether it can drive the screen, are decided under “Access keys” in a place's settings in the project list."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトで、MCP（AI）が書くツールを使うのを、ツールごとに許可・都度承認・拒否から選びます。都度承認は、呼び出しが request: true を付けたときに画面で許可を求めます（付けなければ断ります）。拒否は、何も書かずに断ります（batch は手ごとに）。AI は project_read で都度承認と拒否の項目を読めますが、変えられるのは人だけです。画面からの書き込みには効きません。どのプロジェクトを読み書きできるかと、画面を動かせるかは、プロジェクト一覧の場所の設定の「アクセスキー」で決めます"
          }
        }
      }
    },
    "writes.perItem" : {
      "comment" : "Small label on a group whose items are not all in the same state.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per item"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目ごと"
          }
        }
      }
    },
