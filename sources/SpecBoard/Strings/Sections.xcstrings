          }
        }
      }
    },
    "problem.elsewhere" : {
      "comment" : "Appended to a problem message about a missing card when other sections have one of that name; the argument is the list.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " (Other sections have: %@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（ほかのセクションには %@ があります）"
          }
        }
      }
    },
    "problem.elsewhereHint" : {
      "comment" : "Hint appended to a problem message about a missing card; the arguments are a section path, the card name and the section path of the reader.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ". To use the one in another section, write it with its section (for example: %@:%@), or put a card ghost in section %@ and write it by name alone"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "。ほかのセクションのものは、セクションを付けて書くか（例: %@:%@）、セクション %@ にカードゴーストを置けば名前だけで書けます"
          }
        }
      }
    },
    "problem.foundIn" : {
      "comment" : "Part of a problem message: the sections that have a card of that name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is in: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」があるのは: %@"
          }
        }
      }
    },
    "problem.noSection" : {
      "comment" : "Problem message for an unknown section; the arguments are the name and the list of existing sections.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no section “%@”. There are: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セクション「%@」がありません。あるのは: %@"
          }
        }
      }
    },
    "problem.noSectionBefore" : {
      "comment" : "Problem message when a card name carries a tree but no section; the arguments are the written name, an example section and the card name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” has no section before the card. Don't write a tree in a path; put the section and “:” before the card (for example: %@:%@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はカードの前にセクションがありません。パスにツリーは書かず、カードの前にセクションと「:」を付けます（例: %@:%@）"
          }
        }
      }
    },
    "problem.noSectionsAtAll" : {
      "comment" : "Shown in a problem message listing sections when there are none.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "(no sections)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "（セクションがありません）"
          }
        }
      }
    },
    "problem.oldPath" : {
      "comment" : "Problem message when a section name is written with its root's name; the arguments are the name and how to write it now.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is the old way of writing it. Write a section from below the root: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」は前の書き方です。セクションは根の下から書きます: %@"
          }
        }
      }
    },
    "problem.sectionAmbiguous" : {
      "comment" : "Problem message when a section name is not unique; the arguments are the name, the count and the list.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is the name of %lld sections: %@. Write the path from the parent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セクション「%@」は %lld つあります: %@。親から書いてください"
          }
        }
      }
    },
    "problem.sectionFromTop" : {
      "comment" : "Problem message when only a section's last name was written; the argument is the full path.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write a section from the top of the tree: %@ (the last name of a section alone isn't enough)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セクションは木の頭から書きます: %@（セクションの最後の名前だけでは書けません）"
          }
        }
      }
    },
    "problem.treeInPath" : {
      "comment" : "Problem message when a path names a tree; the arguments are the tree name with @ and the note about branches.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
