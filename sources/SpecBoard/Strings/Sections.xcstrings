    "ghost.deadEndGone" : {
      "comment" : "Problem message about a card ghost whose card was deleted; the argument is the name written.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is a card ghost, but it points at nothing (the card it pointed at is gone; re-point it with target in card_update, or delete it with card_delete)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はカードゴーストですが、指す先がありません（指していたカードは消えました。card_update の target で付け替えるか、card_delete で消します）"
          }
        }
      }
    },
    "ghost.deadEndRound" : {
      "comment" : "Problem message about a card ghost whose chain loops; the argument is the name written.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” is a card ghost, but following what it points at goes in a circle"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はカードゴーストですが、指す先をたどると輪になっています"
          }
        }
      }
    },
