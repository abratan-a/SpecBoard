    "list.noteFew" : {
      "comment" : "Note under the section list when the project has fewer than two sections.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With two or more sections, the bar above switches between sections and draws the Section map for each. Cards in another section are referred to with the section name, like Core:User."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セクションを 2 つ以上にすると、上のバーでセクションを切り替えてセクションマップを描き分けます。別のセクションのカードは Core:User のようにセクション名を付けて指します"
          }
        }
      }
    },
    "list.noteRename" : {
      "comment" : "Note under the section list when the project has two or more sections.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renaming a section also rewrites the old name (“old name:”) wherever it is written in a path."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前を変えると、パスに書かれた「旧名:」も書き換わります"
          }
        }
      }
    },
    "list.openInBranch" : {
      "comment" : "Tooltip of the root's label in the section list when a branch is open; the argument is the branch name.",
      "extractionState" : "manual",
      "localizations" : {
