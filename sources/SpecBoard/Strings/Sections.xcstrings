    "problem.branchesAreNamed" : {
      "comment" : "Note appended to the problem message about trees in paths.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inside a branch, MCP names it with the branch argument (main if omitted); the screen reads and writes the branch that is open."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
