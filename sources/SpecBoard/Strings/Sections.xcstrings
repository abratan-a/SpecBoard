    "list.cantDeleteFixed" : {
      "comment" : "Tooltip of the disabled delete button of the board's built-in Complete or Cancelled section.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The board keeps this section for finished and cancelled goals, so it can't be deleted (you can rename it)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボードが完了・打ち切りの置き場として持つセクションなので、消せません（名前は変えられます）"
          }
        }
      }
    },
    "list.cantDeleteNotEmpty" : {
      "comment" : "Tooltip of the disabled delete button of a section that is not empty.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A section that holds cards or sections can't be deleted (move or delete them first)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードかセクションが中にあるセクションは消せません（移すか消してから）"
          }
        }
      }
    },
    "list.cantDeleteRootOwn" : {
      "comment" : "Tooltip of the disabled delete button of a section directly under the root.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A section directly under the root is set by the project's tree, so it can't be deleted here (you can rename it; remove it under “Project tree” in the “Kinds” tab of Project Settings)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "根の直下のセクションはプロジェクトの木で決まるので、ここでは消せません（名前は変えられます。外すのはプロジェクト設定の「種類」の「プロジェクトの木」で）"
          }
        }
      }
    },
