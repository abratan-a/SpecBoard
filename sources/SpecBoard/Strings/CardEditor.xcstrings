    "deletion.message" : {
      "comment" : "Message of the confirmation before a card is deleted.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its fields are deleted with it. Fields that refer to this card stay as rows, and their target becomes unresolved."
