    "help.also" : {
      "comment" : "Help of the also row in the properties panel of a field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other types it also accepts: string, integer, number, boolean, object. array also accepts an array of this type (“one, or a list of them”). Separate them with a comma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかにも受ける型。string・integer・number・boolean・object。array は、この型の配列も受ける（「1 つか、その並び」）。, で区切る"
          }
        }
      }
    },
    "help.array" : {
      "comment" : "Help of the array row in the properties panel of a field.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Array. The value is an array of this type."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配列。値がこの型の配列"
          }
        }
      }
    },
    "help.cardLabel" : {
      "comment" : "Help of the label row in the properties panel of a card.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Display name: the human-readable name shown beside the name."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示名。名前の横に出す、人が読む名前"
          }
        }
      }
    },
    "help.cardName" : {
      "comment" : "Help of the name row in the properties panel of a card.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Card name. Used in paths (section:card; a name holding a space or a separator such as . is wrapped in single quotes there, like 'release notes.md'). Renaming it updates the paths written in the project."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カード名。パスに使う（セクション:カード名。空白や . などの区切りの字を含む名前は、パスでは 'release notes.md' のように一重引用符で囲む）。改名すると、プロジェクトに書かれたパスもついてくる"
          }
        }
      }
    },
    "help.cardPath" : {
      "comment" : "Help of the path row in the properties panel of a card.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Path including the section. Other cards and documents refer to this card by it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セクション付きのパス。ほかのカードや文書からこの名前で指す"
          }
        }
      }
    },
    "help.cardSize" : {
      "comment" : "Help of the size row in the properties panel of a card.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Size of the card on the diagram (in cells: a width alone, or width × height). Change it by dragging the card's bottom-right corner on the diagram. Leave the height where it is and only the width is set; the height follows the contents. It is only how it looks, so it isn't kept in history."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図のカードの大きさ（マス。幅だけか、幅×高さ）。図でカードの右下をドラッグして変える。高さを動かさなければ幅だけが決まり、高さは中身に合う。見かけなので履歴に残らない"
          }
        }
      }
    },
    "help.connectionsAndHistory" : {
      "comment" : "Tooltip of the menu in a narrow card editor header.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connections (cards it refers to and is referred by, places that mention it) and history"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "つながり（参照している・されているカード、言及している所）と履歴"
          }
        }
      }
    },
    "help.connectionsButton" : {
      "comment" : "Tooltip of the connections button in the card editor header.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards it refers to and is referred by, actions that use it, notes that mention it"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参照している・されているカード、使っている action、言及している note"
          }
        }
      }
    },
    "help.customKind" : {
