    "move.message" : {
      "comment" : "Message of the confirmation before a project is moved; the place it comes from.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moves main, branches, the board, history, MRs, diagram positions and the project's settings, and removes the project from %@ (the project file from before the move is kept on this Mac). Working-directory folder bindings, the default export destinations, access-key permissions and public settings are not moved."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "main・branch・ボード・履歴・MR・図の位置・プロジェクトの設定ごと移し、%@からは消します（移す前のプロジェクトのファイルをこの Mac に残します）。作業ディレクトリのフォルダの結び付け・エクスポートの既定のエクスポート先・アクセスキーの許可・公開は移りません。"
          }
        }
      }
    },
