    "delete.message" : {
      "comment" : "Message of the confirmation before a project is deleted; how many cards it has.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This project's %lld card will be deleted with it. This can't be undone."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "This project's %lld cards will be deleted with it. This can't be undone."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロジェクトの %lld 件のカードも一緒に消えます。元に戻せません。"
          }
        }
      }
    },
