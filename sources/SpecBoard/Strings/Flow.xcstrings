    "problem.duplicateName" : {
      "comment" : "Message when two nodes of a flow share a name; the argument is the name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Two nodes are named %@ (a name can be used once in a flow)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノードの名前 %@ が 2 つあります（名前はフローの中で 1 つずつ）"
          }
        }
      }
    },
    "problem.duplicateNext" : {
      "comment" : "Message when a node's next names a destination twice; the argument is the node.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@, next lists the same destination twice"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の next に同じ行き先が 2 つあります"
          }
        }
      }
    },
    "problem.emptyWhen" : {
      "comment" : "Message when a decision node's branch has no condition; the arguments are the node and the branch's index.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@, when of branches[%lld] is empty (write the condition as text)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の branches[%lld] の when が空です（条件を文字で書く）"
          }
        }
      }
    },
    "problem.manyStarts" : {
      "comment" : "Message when a flow has more than one begin node; the arguments are how many and their names.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There are %lld start (begin) nodes (%@). Keep only one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始（begin）が %lld つあります（%@）。1 つにしてください"
          }
        }
      }
    },
    "problem.missing" : {
      "comment" : "Message about an unfinished node: the arguments are the node, its heading and the missing key.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@) is missing %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@）に %@ がありません"
          }
        }
      }
    },
    "problem.missingWith" : {
      "comment" : "Message about an unfinished node with a hint: the arguments are the node, its heading, the missing key and the hint in parentheses.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@) is missing %@ %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@）に %@ がありません%@"
          }
        }
      }
    },
    "problem.noStart" : {
      "comment" : "Message when a flow has no begin node.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The flow has no start (kind: begin) node. Place one in the flow."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始（kind: begin）のノードがありません。フローに 1 つ置いてください"
          }
        }
      }
    },
    "problem.noSuchNode" : {
      "comment" : "Message when a node's way leads to a node that does not exist; the arguments are the node, the destination and the names of the nodes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ goes to %@, but there is no such node (the nodes are %@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の行き先 %@ というノードがありません（あるのは %@）"
          }
        }
      }
    },
    "problem.nodeExists" : {
      "comment" : "Message when renaming a node to a name another node has; the argument is the name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A node named %@ already exists"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ノード %@ はもうあります"
          }
        }
      }
    },
    "problem.notOneOf" : {
      "comment" : "Message when a node's key has a value that is not allowed; the arguments are the node, the key, the allowed values and the value given.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@, %@ must be one of %@ (not %@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の %@ は %@ のどれかです（%@ ではなく）"
          }
        }
      }
    },
    "problem.onTimeoutNeedsTimeout" : {
      "comment" : "Message when a wait node has onTimeout but no timeout; the argument is the node.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In %@, onTimeout is written together with timeout"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の onTimeout は timeout と一緒に書きます"
          }
        }
      }
    },
    "problem.partEnds" : {
      "comment" : "Message when one of the ways a node parts into ends before meeting; the arguments are the node that parts and the first node of that way.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The way %@ parts into %@ ends without reaching a join (connect each way to a kind: join node)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ から分かれた %@ が合流（join）に着かずに終わります（分かれた先は、それぞれ kind: join のノードへつなぐ）"
          }
        }
      }
    },
    "problem.partMeetMany" : {
      "comment" : "Message when the ways a node parts into meet at different joins; the arguments are the node that parts and the joins.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ways %@ parts into reach different joins (%@) (meet them at the same join node)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ から分かれた先が別々の合流（%@）に着きます（同じ join のノードで合わせる）"
          }
        }
      }
    },
    "problem.partNoJoin" : {
      "comment" : "Message when the ways a node parts into never reach a join; the argument is the node that parts.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ways %@ parts into do not reach a join (meet them at a kind: join node)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ から分かれた先が合流（join）に着きません（kind: join のノードで合わせる）"
          }
        }
      }
    },
    "problem.receiveOnly" : {
      "comment" : "Message when a begin node that does not receive has a key only a receiving one takes; the arguments are the node and the key.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (start): %@ can only be written when trigger is receive"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（開始）の %@ は trigger: receive（受ける）のときだけ書けます"
          }
        }
      }
    },
    "problem.strayNodeKeys" : {
      "comment" : "Message when a node has keys its kind does not take; the arguments are the node, its kind, the keys not allowed, the kind again and the keys allowed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@) cannot have %@. A %@ node can only have %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@）に %@ は書けません。%@ が持つのは %@ です"
          }
        }
      }
    },
    "problem.targetsUnused" : {
      "comment" : "Message when a node still uses the old targets key; the argument is the node.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: targets is not used. For parallel runs, give the previous node's next as an array ([\"a\", \"b\"]) to part the way, and meet at a kind: join node (see the guide, about: flow)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の targets は使いません。並列は、前のノードの next を配列（[\"a\", \"b\"]）にして分かれ、kind: join のノードで合わせます（形は guide の about: flow）"
          }
        }
      }
    },
    "sequence.note" : {
      "comment" : "Note under the sequence diagram in the flow editor.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click an arrow, note or frame to select its node or process-node row and edit it in the Properties panel (inside a called flow, that flow's row). Double-click a card or a called flow's head to open it. To add or move nodes, use the “Contents map”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "矢印・メモ・枠を押すと、そのノードか処理ノードの行を選んでプロパティパネルで直せます（呼んだ flow の中のものは、その flow の行）。カードと呼んだ flow の見出しはダブルクリックで開きます。ノードを足す・動かすのは「コンテンツマップ」で"
          }
        }
      }
    },
    "shape.cardMap" : {
      "comment" : "Name of the flow editor shape that draws the nodes on a grid, in the shape switch and the card's diagram picker.",
