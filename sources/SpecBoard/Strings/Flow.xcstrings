        }
      }
    },
    "shape.sequence" : {
      "comment" : "Name of the flow editor shape that draws the flow as a sequence diagram, in the shape switch and the card's diagram picker.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sequence diagram"
