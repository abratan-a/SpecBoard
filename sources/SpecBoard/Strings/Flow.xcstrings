    "toolbar.addNodeHelp" : {
      "comment" : "Tooltip of the add-node menu in the flow editor's bar.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a node to the right of the selected one and makes it that node's next."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んでいるノードの右に足し、そのノードの次にします"
          }
        }
      }
    },
    "toolbar.shapeHelp" : {
      "comment" : "Tooltip of the shape switch in the flow editor's bar.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contents map: arrange and edit the nodes. Sequence diagram: see the same flow as exchanges with its partners. The shape it opens in is the card's diagram."
          }
        },
        "ja" : {
