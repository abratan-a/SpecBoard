    "hold.elsewhere" : {
      "comment" : "Banner while another Mac does a group edit; that Mac's name, the tree's name and the start time.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Group edit in progress in the window on %@ (%@, since %@). This branch is read-only until it ends."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の画面でまとめて直しています（%@、%@ から）。終わるまで、この branch は読むだけです"
          }
        }
      }
    },
    "hold.groupLocked" : {
      "comment" : "Banner while this window does a group edit of a locked main; the tree's name and the start time.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Group edit in progress (%@, since %@). main is locked, so closing puts what you changed into main as one merge. Meanwhile MCP writes and merges are refused."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まとめて直しています（%@、%@ から）。main はロック中なので、閉じると直したものが 1 つの merge として main に入ります。その間、MCP の書き込みと merge は断ります"
          }
        }
      }
    },
    "hold.groupOpen" : {
      "comment" : "Banner while this window does a group edit; the tree's name and the start time.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Group edit in progress (%@, since %@). Edits until you close become one commit, and MCP writes to this branch are refused."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まとめて直しています（%@、%@ から）。閉じるまでの直しは 1 つのコミットになり、この branch への MCP の書き込みは断ります"
          }
        }
      }
    },
