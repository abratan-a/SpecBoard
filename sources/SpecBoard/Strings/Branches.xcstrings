    "merge.keepHelp" : {
      "comment" : "Tooltip of the keep-branch checkbox in the merge window.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When off, the branch is set aside after it goes into main (it leaves the list and its name becomes free; it comes back if a revert of this merge goes into main). When on, it stays, in the same state as main."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "切ると、main に入れたあと branch を退けます（一覧から外れ、名前も空きます。この merge を取り消す戻すが main に入ると戻ります）。入れると、main と同じ形で残します"
          }
        }
      }
    },
