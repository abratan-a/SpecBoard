    "merge.explainBranch" : {
      "comment" : "Explanation in the merge window when the source is a branch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything changed in the source goes into the target. Where both sides changed the same thing differently, you choose which side to take."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "merge 元で変えたこと全部を merge 先に入れます。両側で同じ所を違うように直した所は、どちらを取るかを選びます"
          }
        }
      }
    },
