    "term.stackdoc" : {
      "comment" : "What the word stackdoc means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A stacked document. A document placed in a Document section in which versions (versions) are stacked from newest to oldest (such as a change history). The diagram and the editor show the version chosen with the selector. When exported, the whole card is one file; if you write a version's path in an item of the export, only that version is exported"
          }
        },
        "ja" : {
