    },
    "term.file" : {
      "comment" : "What the word file means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A file. A card that the core creates inside a working directory's section by reading the working directory (the folder bound on this machine). Its name and display name are the file's name (in a path, a name holding a separator character is wrapped in single quotes: repo/docs:'CardKinds.md'), and filePath is the path from the working directory, and language is the language its name and the working directory's parsers decide. It is read only, and cards in main and branches point at it with the implementedBy line. In a file of a language whose functions and types are read, those (symbol) can be pointed at too, and the map lists them as its rows"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイル。作業ディレクトリ（この機械で結び付けたフォルダ）を読んで、コアが作業ディレクトリのセクションの中に作るカード。名前と表示名はファイルの名前（パスでは区切りの字を含む名前を一重引用符で囲む: repo/docs:'CardKinds.md'）、filePath は作業ディレクトリからのパス、language は名前と作業ディレクトリの parsers で決まる言語。読むだけで、main と branch のカードから実装の線（implementedBy）で指す。関数と型を拾う言語のファイルは、中の関数と型（symbol）も指せ、図ではそれを行で並べる"
          }
        }
      }
    },
    "term.flow" : {
      "comment" : "What the word flow means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What a component does, and the flow of processing across components (receiving an MCP request, user registration, and so on; components are represented by sections). It is a container card; node cards of the kinds begin, process, run, eval, wait, join and end are placed inside it and connected by lines"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部品がすることと、部品をまたぐ処理の流れ（MCP のリクエストを受ける・ユーザー登録など。部品はセクションで表す）。入れ物のカードで、中に開始・処理・実行・判断・待つ・合流・終了のノードのカードを置き、線でつなぐ"
          }
        }
      }
    },
    "term.formatdoc" : {
      "comment" : "What the word formatdoc means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A formatted document. A design or specification document built from items and rows (rows), placed in a Document section. When exported, one document becomes one file"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整形文書。ドキュメントセクションに置く、項目と行（rows）で組んだ設計書・仕様書。エクスポートすると 1 枚が 1 ファイル"
          }
        }
      }
    },
    "term.frame" : {
      "comment" : "What the word frame means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A frame. Placed in a UI section, it puts the mock of the UI section in its field target into its own box at full size (what overflows is cut). target is written as a path, kept by id, and follows renames and moves. It cannot point at the section it is in, nor at one that leads back to it. The same section can be used by many frames. It can be resized; by default it is one card in size"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "はめ込み。UI のセクションに置き、欄 target の UI のセクションのモックを自分の箱に 1:1 ではめ込む（はみ出す所は切る）。target はパスで書き、id で覚えて改名・移動に付いて行く。自分のいるセクションと、たどると自分のいるセクションに戻るものは指せない。同じセクションを何枚ものはめ込みで使える。大きさを変えられ、既定はカード 1 枚分"
          }
        }
      }
    },
    "term.free" : {
      "comment" : "What the word free means, in the glossary and the help of the screen.",
