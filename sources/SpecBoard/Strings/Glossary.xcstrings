    "term.at" : {
      "comment" : "What the word at means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where a line lands inside the partner (a field or a row; if outside the partner, its full path)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線が相手の中で着く所（欄か行。相手の外なら、そこのフルパス）"
          }
        }
      }
    },
    "term.base" : {
      "comment" : "What the word base means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The contents of main at the time a card of main was first written in a branch. What a branch changed is stated by comparing against base (branch_read)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "branch で main のカードを初めて書いたときの main の中身。branch で変えたことは base と比べて言う（branch_read）"
          }
        }
      }
    },
    "term.begin" : {
      "comment" : "What the word begin means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start. It has trigger and the next line. When it begins by receiving (receive), it takes partner lines to the partner flows (any number) and program (leaving both out is a gap (partner not written); if any caller may call it, anyCaller: true), and carries"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始。trigger と next の線。受けて始まる（receive）ときは相手のフローへの partner の線（何本でも）と program（どちらも省くのは穴（相手が書かれていない）。呼び手を問わないなら anyCaller: true）・carries"
          }
        }
      }
    },
    "term.board" : {
      "comment" : "What the word board means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Project Board. A tree outside main and the branches that holds to-dos (goals and sub-goals, and working documents). It has no merge, lock or MR, and can be written at any time. In MCP it is branch: \"_project_board_\". A card on the board can draw a Linked line (link) to a card in main and can write main paths in its body (a line cannot be drawn from main to the board)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトボード。やること（目標と小目標・作業の文書）を置く、main・branch の外の木。merge・ロック・MR は無く、いつでも書ける。MCP は branch: \"_project_board_\"。ボードのカードからは main のカードへ「つながる」線（link）を引け、本文に main のパスを書ける（main からボードへは引けない）"
          }
        }
      }
    },
    "term.body" : {
      "comment" : "What the word body means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The body of a note and a freedoc (Markdown). [[path]] points at a field ([[section:]] at a section, [[path|text]] shows other words), {{path}} inserts a value (a field with const, an enumeration, or a value in data), and a line of ![[path]] puts in a diagram"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "note と freedoc の本文（Markdown）。[[パス]] で欄を指し（[[セクション:]] でセクション、[[パス|字]] で見せる字を変える）、{{パス}} で値（const のある欄・列挙・データの値）を差し込み、![[パス]] の 1 行で図を入れる"
          }
        }
      }
    },
    "term.branch" : {
      "comment" : "What the word branch means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A plan for changes. It is made from main, sees all of main as it was when the branch was made, and only what is written in the branch belongs to the branch. Changes made to main afterward do not show up until main is merged in. It cannot be seen from main, and branches cannot see each other"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更の計画。main から作り、作ったときの main の全部を見て、branch で書いたものだけが branch のものになる。作ったあとの main の変更は、main を取り込むまで映らない。main からは見えず、branch どうしも見えない"
          }
        }
      }
    },
    "term.call" : {
      "comment" : "What the word call means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calls a tool outside the project (program) and waits for the reply (sends carries and receives returns). Calling and waiting for a flow of the project is done by a run node"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトに無い道具（program）を呼んで返りを待つ（carries を送り、returns を受ける）。プロジェクトの flow を呼んで待つのは実行ノード"
          }
        }
      }
    },
    "term.compute" : {
      "comment" : "What the word compute means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Computation. Processing that does not go outside, such as business validation or calculation (what it does is in the row's description; it has no other fields or lines)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算。業務の検証や計算のような、外に出ない処理（何をするかは行の description。ほかの欄・線は持たない）"
          }
        }
      }
    },
    "term.connections" : {
      "comment" : "What the word connections means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The list of a card's lines. Each line has line (the kind of line), from (the field or row it leaves from; the head if left out), to (the partner), at (where it lands inside the partner), description, and fields (fields decided by the kind of line)"
          }
        },
