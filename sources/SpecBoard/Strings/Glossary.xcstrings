        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いまの実装を表すツリー。プロジェクトに 1 つ"
          }
        }
      }
    },
    "term.merge" : {
      "comment" : "What the word merge means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
