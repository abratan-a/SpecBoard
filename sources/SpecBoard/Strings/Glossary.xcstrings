    "term.data" : {
      "comment" : "What the word data means, in the glossary and the help of the screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The values of data (instance). JSON nested in the same way as the shape (keys are field names; array fields are arrays). The values written are checked against the type, nullable, const, enumeration values and discriminator branches of the shape's fields, and string values against the pattern of the field's rules, and refused if they do not match. A missing required shows up in the inspection as still being written. The values of fields removed from the shape remain in strayFields"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データ（instance）の値。形と同じ入れ子の JSON（キーはフィールドの名前、並びの欄は配列）。書いた値は形のフィールドの型・nullable・const・列挙の値・判別子の枝と、文字の値は欄の rules の pattern で確かめ、合わなければ断る。required の欠けは書き途中として点検に出る。形から消えたフィールドの値は strayFields に残る"
          }
        }
      }
    },
    "term.diagram" : {
