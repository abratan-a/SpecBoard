    "builtin.contextChanged" : {
      "comment" : "Badge on a built-in kind whose purpose and usage notes this project has rewritten.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usage rewritten in this project"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使う場面をこのプロジェクトで書き換え"
          }
        }
      }
    },
    "builtin.help" : {
      "comment" : "Explanation under the name of a built-in kind in the Kinds tab.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in definitions are read-only, and their names can't be used by the project's own definitions. What a kind is for, when to use it and when not, and a section kind's mark in the navigator can be rewritten for this project (an AI reads them with kind_list and kind_read)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "組み込みの定義は読むだけで、名前はプロジェクトの定義では使えません。何のためか・使うとき・使わないときと、セクションの種類のナビパネルの印は、このプロジェクトに合わせて書き換えられます（AI が kind_list・kind_read で読みます）"
          }
        }
      }
    },
