    "validation.nameChars" : {
      "comment" : "Problem when a row name is not a name: too long, or with a control character or spaces around it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The row name “%@” has 1 to 255 characters, with no line break, tab or other control character and no spaces before or after it"
