    "editor.jsonHelp" : {
      "comment" : "Explanation above the JSON editor of a project-defined kind.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Write it as JSON (the shape is the same as MCP's guide, about: kind_create). It is checked as you write (dryRun of kind_create and kind_update)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JSON で書きます（形は MCP の guide の about: kind_create と同じ）。書くと、その場で確かめます（kind_create・kind_update の dryRun）"
          }
        }
      }
    },
    "editor.renameHelp" : {
      "comment" : "Tooltip on the Rename button of a kind of card's editor.",
      "extractionState" : "manual",
      "localizations" : {
