      }
    },
    "card.addHelp" : {
      "comment" : "Tooltip of the Add card button in a container card's editor bar.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name a card and choose its kind, then create it at the end of this container's contents (one commit)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前と種類を決めて、この入れ物の中身の終わりにカードを作ります（1 つのコミット）"
          }
        }
      }
    },
    "card.empty" : {
      "comment" : "Shown in the middle of a container card's editor when it holds nothing yet.",
