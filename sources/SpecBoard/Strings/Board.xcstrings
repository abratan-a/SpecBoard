    "goal.mapHint" : {
      "comment" : "The hint under a goal's contents map that explains how to use it.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a card to edit its fields in the Properties panel. Check the box to mark it done. The number is the work order (reorder with “Move earlier” and “Move later” in the right-click menu). The height follows the body; change the size with the corner at the bottom right (reset it with “Reset size to auto” in the right-click menu). Double-click to open (a goal inside opens as its contents map). Drag to move it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードを選ぶとプロパティパネルで欄を直せます。チェックで済みに。番号は作業の順（右クリックの「前へ」「後ろへ」で並べ替え）。高さは本文に合わせ、右下の角で大きさを変えます（右クリックの「大きさを自動に戻す」で戻す）。ダブルクリックで開きます（中の goal はそのコンテンツマップ）。ドラッグで置き直します"
          }
        }
      }
    },
    "goal.modesHelp" : {
      "comment" : "Tooltip of the contents map / body switch in a goal's card editor bar.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contents map: see and move the tasks and goals inside / Body: write the goal's body (the finished form and the order to work in)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンテンツマップ: 中の task と goal を並べて見る・動かす／本文: goal の本文（完成系と進める順）を書く"
          }
        }
      }
    },
