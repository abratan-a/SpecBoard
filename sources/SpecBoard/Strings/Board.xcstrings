{
  "sourceLanguage" : "en",
  "strings" : {
    "action.discardConfirm" : {
      "comment" : "Destructive button of the alert that cancels a goal and discards its branch's changes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discard Changes and Cancel"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更を捨てて打ち切る"
          }
        }
      }
    },
    "action.discardKeep" : {
      "comment" : "Button of the alert about cancelling a goal that leaves everything as it is.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't Cancel"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "やめる"
          }
        }
      }
    },
    "action.discardMessage" : {
      "comment" : "Message of the alert asked before cancelling a goal; the first argument is the branch name, the second how many of its changes are not in main.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The branch %@ has changes not in main (%lld). Cancelling the goal deletes the branch and discards them."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "branch %@ に main へ入っていない変更が %lld 件あります。打ち切ると branch ごと捨てます"
          }
        }
      }
    },
    "action.discardTitle" : {
      "comment" : "Title of the alert asked before cancelling a goal whose branch has changes not in main; the argument is the goal's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel %@?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を打ち切りますか？"
          }
        }
      }
    },
    "action.startConfirm" : {
      "comment" : "Button of the sheet that starts a goal with the branch name typed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始"
          }
        }
      }
    },
    "action.startMessage" : {
      "comment" : "Line under the title of the sheet that starts a goal.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Creates the branch to work on this goal in, and sets the goal in progress. Name the branch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この goal を進める branch を作り、goal を進行中にします。branch の名前を決めてください"
          }
        }
      }
    },
    "action.startPlaceholder" : {
      "comment" : "Placeholder of the branch name field in the sheet that starts a goal.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Branch name"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "branch の名前"
          }
        }
      }
    },
    "action.startTitle" : {
      "comment" : "Title of the sheet that asks for the branch name when starting a goal; the argument is the goal's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を開始"
          }
        }
      }
    },
    "actions.menu" : {
      "comment" : "Submenu in a goal's or a task's right-click menu listing the actions that can be done to it now.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Actions"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アクション"
          }
        }
      }
    },
    "actions.rowHelp" : {
      "comment" : "Tooltip of the actions row in the Properties panel of a goal or a task.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What can be done to this card now. Each changes its fields, its branch and where it is kept in one step (card_action)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このカードに今できること。押すと欄・branch・置き場をまとめて変えます（card_action）"
          }
        }
      }
    },
    "actions.rowHelpCode" : {
      "comment" : "Tooltip of the actions row in the Properties panel of a card with implementation lines (lines to files).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compare the card with the code its implementation lines point at, then record that code as it is now (card_action reviewed). The card itself is not changed."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードと、実装の線の先のコードを見比べたあとで、そのコードを今の形で覚え直します（card_action の reviewed）。カードは書き換わりません"
          }
        }
      }
    },
    "add.whereTo" : {
      "comment" : "Line under the title of the popover that adds a task or a card; the argument is the full path of the goal or container.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds at the end of the contents of %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の中身の終わりに足します"
          }
        }
      }
    },
    "block.labelAndName" : {
      "comment" : "Heading of a kind of row in a card editor: the row kind's label and then its name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@）"
          }
        }
      }
    },
    "card.add" : {
      "comment" : "Button in a container card's editor bar, the empty contents map's button and the title of the popover that adds a card.",
