{
  "sourceLanguage" : "en",
  "strings" : {
    "alert.failedTitle" : {
      "comment" : "Alert title when checking failed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't check for updates"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "確認できませんでした"
          }
        }
      }
    },
    "alert.upToDate" : {
      "comment" : "Alert text after a manual check found nothing new. The argument is the installed version.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is the latest release."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が最新のリリースです。"
          }
        }
      }
    },
    "error.devBuild" : {
      "comment" : "Update problem shown when the app is not installed in Applications.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Development builds don't update. Only a copy installed in /Applications updates itself"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開発ビルドなので更新しません。/Applications に入れた版だけが自分で更新します"
          }
        }
      }
    },
    "error.downloadFailed" : {
      "comment" : "Update problem: the DMG download failed. Arguments: the file name, the HTTP status.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't download %@ (%lld)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ を取得できませんでした（%lld）"
          }
        }
      }
    },
    "error.githubRefused" : {
      "comment" : "Update problem: GitHub answered 401 or 403 for another reason than its request limit. The argument is the HTTP status.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub refused the request (%lld). The token is wrong, or the repository isn't public"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub に断られました（%lld）。トークンが違うか、このリポジトリが公開されていません"
          }
        }
      }
    },
    "error.noRelease" : {
      "comment" : "Update problem: the server answered 404. The argument is the repository (owner/name).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No release found. It isn't published yet, or the token can't see %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リリースが見つかりません。まだ公開されていないか、トークンから %@ が見えていません"
          }
        }
      }
    },
    "error.noSource" : {
      "comment" : "Update problem shown when no update source exists.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no update source. Add one under “Update source” in Settings"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取得元がありません。設定の「取得元」で足してください"
          }
        }
      }
    },
    "error.noTeam" : {
      "comment" : "Update problem: the running app has no signing team to compare with.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Can't tell whether the update may replace this app, because the team that signed this app is unknown"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリの署名のチームが分からないので、入れ替えられるか判断できません"
          }
        }
      }
    },
    "error.rateLimited" : {
      "comment" : "Update problem: GitHub answered 429, or 403 with no requests left in the hour. The argument is the HTTP status.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub's request limit was reached. Will check again later (%lld)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GitHub の問い合わせの上限に達しました。しばらくしてからもう一度確かめます（%lld）"
          }
        }
      }
    },
    "error.refused" : {
      "comment" : "Update problem: a Forgejo or Gitea server answered 401 or 403. The argument is the HTTP status.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgejo refused the request (%lld). This update source needs a token, or the token is wrong. Enter a token with the read:repository permission under “Update source” in Settings"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forgejo に断られました（%lld）。この取得元はトークンが要るか、入れたトークンが違います。設定の「取得元」で read:repository の権限のあるトークンを入れてください"
          }
        }
      }
    },
    "error.serverStatus" : {
      "comment" : "Update problem: an unexpected HTTP status from the update source. The argument is the status.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The update source returned %lld"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取得元が %lld を返しました"
          }
        }
      }
    },
    "error.swapNotStarted" : {
      "comment" : "Update problem: the script that replaces the app did not start. The argument is the reason.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't start the replacement: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入れ替えを始められませんでした: %@"
          }
        }
      }
    },
