    "notice.available" : {
      "comment" : "Notification: a new version is available. Arguments: the version, the update source's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Version %1$@ is available (%2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい版 %1$@ があります（%2$@）"
          }
        }
      }
    },
    "notice.download" : {
      "comment" : "Button on the new-version notification and its row in the bell's list.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロード"
          }
        }
      }
    },
    "notice.downloadHelp" : {
      "comment" : "Tooltip of the Download button on the new-version notification.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads and verifies this version. The app keeps running."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この版をダウンロードして確かめます。アプリは終了しません"
          }
        }
      }
    },
    "notice.failed" : {
      "comment" : "Shown in the toolbar after a failed replacement. The argument is the reason.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The update failed: %@. The previous version is running"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新できませんでした: %@。前の版のまま起動しています"
          }
        }
      }
    },
    "notice.ready" : {
      "comment" : "Notification: a new version was downloaded and verified. Arguments: the version, the update source's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is ready (%2$@). Install it with “Update now”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ を用意しました（%2$@）。「今すぐアップデート」で入れ替えます"
          }
        }
      }
    },
    "pill.check" : {
      "comment" : "Toolbar button that checks for a new version.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check for updates"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アップデートを確認"
          }
        }
      }
    },
    "pill.checkHelp" : {
      "comment" : "Tooltip of the Check for updates button. Arguments: the update source's name, how often it is checked (lower case, e.g. “every 6 hours”).",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks %1$@ for a new version now. It also checks %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@に新しい版があるかを今すぐ確認します。%2$@にも確認しています"
          }
        }
      }
    },
    "pill.checkHelpOff" : {
      "comment" : "Tooltip of the Check for updates button when periodic checks are off. The argument is the update source's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checks %@ for a new version now. Periodic checks are off."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に新しい版があるかを今すぐ確認します。定期の確認は切っています"
          }
        }
      }
    },
    "pill.download" : {
      "comment" : "Toolbar button while a new version is available and not downloaded yet. Arguments: the version, the update source's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download %1$@ (%2$@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ をダウンロード（%2$@）"
          }
        }
      }
    },
    "pill.downloadHelp" : {
      "comment" : "Tooltip of the toolbar's Download button. Arguments: the current version, the new version.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@. Downloads and verifies it; the app keeps running. Then “Update now” appears."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ → %2$@。ダウンロードして確かめます。アプリは終了しません。済むと「今すぐアップデート」に変わります。"
          }
        }
      }
    },
    "pill.readyHelp" : {
      "comment" : "Tooltip of the Update now button. Arguments: the current version, the new version.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ → %@. The app quits and relaunches. The selected card and the window's state come back as they were, and MCP sessions reconnect."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ → %@。アプリを終了して起動し直します。選択中のカードとウィンドウの状態はそのまま戻り、MCP のセッションは繋ぎ直します。"
          }
        }
      }
    },
    "pill.upToDate" : {
      "comment" : "Shown for a few seconds in the toolbar after a manual check found nothing new.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Up to date"
          }
