    "dirs.readHelp" : {
      "comment" : "Tooltip of the picker for how a working directory is read.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Don't read” does not read the inside (the tree is only the box, and lines to files in it are not checked). “Basic” leaves out .git/ and .DS_Store. “git repository” also leaves out what .gitignore says (the same as Basic where there is no git)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "読まないは中を読まない（木は箱だけで、そこのファイルへの線は確かめない）。基本は .git/ と .DS_Store を外す。git リポジトリはそれに .gitignore のもの（git の無い所では基本と同じ）"
          }
        }
      }
    },
    "dirs.readNone" : {
      "comment" : "Option of how a working directory is read: its inside is not read.",
