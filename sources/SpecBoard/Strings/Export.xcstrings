    "folder.panelMessage" : {
      "comment" : "Message of the folder panel for an export's default folder; the argument is the export's name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose the folder that export %@ is written to (inside a repository's working tree, you can commit what is written as it is)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクスポート %@ のエクスポート先にするフォルダを選んでください（リポジトリの作業ツリーの中なら、エクスポートしたものをそのまま commit できます）"
          }
        }
      }
    },
    "header.about" : {
      "comment" : "Explanation under the title of the exports screen; the argument is the place name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each export decides what to write where. The folder it is written to is the export's default folder (set on %@) or the folder you choose when exporting. Exporting from a section includes the cards of writable kinds in it and in the sections under it (unless limited by kind, flows are left out, and notes are included only in schema sections), and a single card is written by the row nearest to it. This is a project setting: it does not change per branch and main's lock does not apply."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクスポートごとに、何をどこに書くかを決めます。書く先のフォルダは、エクスポートごとの既定の先（%@の設定）か、書くときに選んだフォルダです。セクションから書くと、下のセクションまでの書ける種類のカードが入り（種類で絞らなければ flow は入らず、note はスキーマのセクションだけ）、1 枚のカードはそれに一番近い行で書かれます。プロジェクトの設定で、branch では変わらず、main のロックも受けません"
          }
        }
      }
    },
    "header.exportAllHelp" : {
      "comment" : "Tooltip of the button that writes every export; the argument is the place name.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Writes main into each export's default folder on %@ (main even when a branch is open)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "main を、エクスポートごとに%@の既定のエクスポート先のフォルダへ書きます（branch を開いていても main）"
          }
        }
      }
    },
    "header.exportElsewhereHelp" : {
      "comment" : "Tooltip of the button that exports everything once to another folder.",
