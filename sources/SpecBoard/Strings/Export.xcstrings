        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "基本"
          }
        }
      }
    },
    "dirs.readGit" : {
      "comment" : "Option of how a working directory is read: also leaves out what .gitignore says.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git repository"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "git リポジトリ"
