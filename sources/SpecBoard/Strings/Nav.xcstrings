    "tree.autoHelp" : {
      "comment" : "Tooltip of the automatic section-ghost group row in the navigator tree.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cards in other sections that this section's lines reach (automatic). In the Section map they are gathered into one section ghost per section, showing only where lines reach. To show a whole card, place a card ghost in this section: right-click the card, or drag it while holding ⌥⌘."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このセクションの線が届く、ほかのセクションのカード（自動）。セクションマップでは、セクションごとに 1 枚のセクションゴーストにまとまり、線の届く所だけが出ます。カードを丸ごと出すには、カードの右クリックか ⌥⌘ を押しながらのドラッグで、このセクションにカードゴーストを置きます"
          }
        }
      }
    },
    "tree.boardOpen" : {
      "comment" : "Tooltip of the root row in the navigator when the Project Board is the open tree.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Project Board is open"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロジェクトボードを開いています"
          }
        }
      }
    },
    "tree.branchOpen" : {
      "comment" : "Tooltip of the root row in the navigator when a branch is open; the argument is the branch name.",
