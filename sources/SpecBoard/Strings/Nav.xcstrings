    "prompt.branchMessage" : {
      "comment" : "Message of the name sheet when creating a branch.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A branch is where you plan changes. It is made from main and opens as soon as it is made. Whatever you change inside becomes a change in the branch, and what you haven't touched shows main as it is now."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "branch は変更の計画を立てる場所です。main から作り、作るとすぐ開きます。中ではどこを直しても branch の変更になり、触っていない所は main の今が見えます"
          }
        }
      }
    },
