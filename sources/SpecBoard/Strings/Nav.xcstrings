{
  "sourceLanguage" : "en",
  "strings" : {
    "alert.branchChanges" : {
      "comment" : "Message of the delete-branch dialog; the argument is how many things the branch changed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The %lld item changed, created or deleted in this branch will be deleted too. This can't be undone."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "The %lld items changed, created or deleted in this branch will be deleted too. This can't be undone."
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この branch で変えた・作った・消したもの %lld 件も一緒に消えます。元に戻せません。"
          }
        }
      }
    },
    "alert.branchUnchanged" : {
      "comment" : "Message of the delete-branch dialog when the branch has no changes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing was changed in this branch."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この branch で変えたものはありません。"
          }
        }
      }
    },
