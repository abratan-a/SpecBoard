{
  "sourceLanguage" : "en",
  "strings" : {
    "item.markAsDesignedHelp" : {
      "comment" : "Tooltip of the Mark as designed button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark it as by design, with a reason (it leaves To fix and Info)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設計どおりのものとして、理由を添えて印を付ける（直すもの・情報から外れる）"
          }
        }
      }
    },
    "item.markAsDesignedMenu" : {
      "comment" : "Button on an inspection item that opens the form for marking it as by design.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mark as designed…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設計どおりにする…"
          }
        }
      }
    },
    "item.markedBy" : {
      "comment" : "A reason an item was marked as by design, followed by who said so.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@）"
          }
        }
      }
    },
    "item.putBack" : {
      "comment" : "Button on an item marked as by design: take the mark off.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put back"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "戻す"
          }
        }
      }
    },
    "item.putBackHelp" : {
      "comment" : "Tooltip of the Put back button.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remove the as-designed mark and put the item back in its group"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設計どおりの印を外し、元の組に戻す"
          }
        }
      }
    },
    "item.wasAsDesigned" : {
      "comment" : "Under an inspection item that was marked as by design before it changed; the argument is the earlier reason and who gave it.",
