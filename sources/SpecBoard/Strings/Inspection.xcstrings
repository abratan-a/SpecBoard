    "names.more" : {
      "comment" : "End of a long list of names, after the first dozen: how many more there are.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "… and %lld more"
