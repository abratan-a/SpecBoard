        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近いのは: %3$@（セクション %2$@ には全 %1$lld 件。card_list の query で探せます）"
          }
        }
      }
    },
    "names.noCard" : {
      "comment" : "Message when a card name matches nothing; the second argument is the help that follows (the closest names, or how to look).",
