        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "…ほか %lld 件"
          }
        }
      }
    },
    "names.nearProject" : {
      "comment" : "Help after a card name that matches nothing, listing the closest names of the whole project.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "There is %lld card in this project. Closest: %@. Search with card_list's query"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "There are %lld cards in this project. Closest: %@. Search with card_list's query"
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近いのは: %2$@（このプロジェクトには全 %1$lld 件。card_list の query で探せます）"
          }
        }
      }
    },
    "names.nearSection" : {
      "comment" : "Help after a card name that matches nothing, listing the closest names of one section.",
