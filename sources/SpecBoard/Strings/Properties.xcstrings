    "frameTarget.gone" : {
      "comment" : "Picker of a frame card's target, when the section it held is gone.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The section is gone"
          }
