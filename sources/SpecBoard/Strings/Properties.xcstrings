      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The box's size in cells: %1$lld to %3$lld wide, %2$lld to %3$lld tall. Changing it moves no card."
          }
        },
        "ja" : {
