{
  "sourceLanguage" : "en",
  "strings" : {
    "description.empty" : {
      "comment" : "Shown in the description pane of the Properties panel when the project is read-only and the description is empty.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing written"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書いていません"
          }
        }
      }
    },
    "description.linePlaceholder" : {
      "comment" : "Faint text in the description box of the Properties panel when a line is picked.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A description of just this line (goes into the notes and comments of the export)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この線 1 本だけの説明（エクスポートの注記・コメントに載る）"
          }
        }
      }
    },
    "description.none" : {
      "comment" : "Shown in the description pane of the Properties panel when what is picked has no description.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What is picked has no description"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んでいるものは説明を持ちません"
          }
        }
      }
    },
    "editor.shape" : {
      "comment" : "Label in the editor bar of a table or data card; the argument is the name of the card that gives the shape.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shape %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "形 %@"
          }
        }
      }
    },
    "empty.nothing" : {
      "comment" : "Shown in the Properties panel when nothing is picked.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open a section or pick a card or row, and its properties appear here"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "セクションを開くか、カードや行を選ぶと、その属性がここに出ます"
          }
        }
      }
    },
    "file.languageHelp" : {
      "comment" : "Help for a file's language in the property panel.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file's language, from its name and the working directory's parsers. Its functions and types are read with it."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの言語。名前と作業ディレクトリの parsers で決まり、関数と型はこの言語で読む"
          }
        }
      }
    },
    "file.parseErrorsHelp" : {
      "comment" : "Help for the count of parts of a file that could not be parsed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many parts of the file could not be parsed. What could be read is shown."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解けなかった所の数。拾えた分は出しています"
          }
        }
      }
    },
    "file.symbolsProblemHelp" : {
      "comment" : "Help for why a file's functions and types are missing or partial.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why its functions and types could not all be read"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "関数と型を拾えなかった（全部は拾えなかった）わけ"
          }
        }
      }
    },
    "fold.collapse" : {
