    },
    "frameTarget.help" : {
      "comment" : "Tooltip of a frame card's target picker.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The UI section whose mock this frame puts in its box, at full size (cut at the box). A section that would lead back to this one can't be chosen."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この箱に 1:1 ではめ込む UI のセクション（はみ出す所は切る）。たどると自分のいるセクションに戻るものは選べません"
          }
        }
      }
    },
    "frameTarget.noUi" : {
      "comment" : "Tooltip of a frame card's target picker when there is no other UI section to choose.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no other UI section to put in. Make one first."
