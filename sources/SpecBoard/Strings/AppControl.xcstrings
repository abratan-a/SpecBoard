    "error.areaForm" : {
      "comment" : "app_control's answer to a malformed area.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pass area as {x, y, width, height} (width and height positive)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "area は {x, y, width, height}（幅と高さは正の数）で渡してください"
          }
        }
      }
    },
    "error.branchNotInWindow" : {
      "comment" : "app_control's answer when the branch named for state, view or capture isn't the tree the window has open. The arguments are the branch named and the one open.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The window does not have the branch “%@” open (it has “%@”). Open it with op: select"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "窓は branch「%@」を開いていません（開いているのは「%@」）。開くのは op: select です"
          }
        }
      }
    },
    "error.cantReadProject" : {
