    "error.directoryTree" : {
      "comment" : "app_control's answer when a call names the tree “_directory_”, which the working directories no longer are.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "There is no tree “_directory_”: the working directories are sections of main and every branch. Leave branch out (or name a branch) and give the path from the working directory's section, e.g. repo/src:'a.rs'"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「_directory_」という木はありません。作業ディレクトリは main と各 branch のセクションです。branch を省くか branch を名指しして、作業ディレクトリのセクションからのパス（例: repo/src:'a.rs'）を渡してください"
          }
        }
      }
    },
