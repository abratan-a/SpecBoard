            "value" : "%@: items can be nested at most %lld deep (put deeper parts in another document and connect them with [[…]])"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: 項目は %lld 段までです（深い所は別の文書にして [[…]] でつなぎます）"
          }
        }
      }
    },
    "validate.nameTwice" : {
      "comment" : "Validation message for formatdoc rows: two sibling rows share a name. The first argument is where.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.name “%@” appears twice at the same level (name is used in paths, so it must be unique within the same parent)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@.name「%@」が同じ階層に二つあります（name はパスに使うので同じ親の中で一意に）"
          }
        }
      }
    },
    "validate.needsTargetCard" : {
      "comment" : "Validation message for formatdoc rows: a card-table row without a target.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
