    "add.hint" : {
      "comment" : "Hint beside the add buttons under a formatdoc being edited.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds inside the selected item, after the selected row, or at the end if none is selected. Right-click to reorder, change the level, or delete"
