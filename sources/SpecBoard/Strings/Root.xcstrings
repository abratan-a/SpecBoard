{
  "sourceLanguage" : "en",
  "strings" : {
    "archived.banner" : {
      "comment" : "Banner above the window when the open project is archived.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This project is archived (read-only). Restore it to make changes."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブのプロジェクトです（読むだけ）。書き換えるには元に戻してください"
          }
        }
      }
    },
    "archived.restore" : {
      "comment" : "Button in the archived-project banner that restores the project.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元に戻す"
          }
        }
      }
    },
    "arrange.byLines" : {
      "comment" : "Item of the Arrange menu on the diagram band and of the Edit menu that lays the whole map out along its lines.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrange by lines"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線に沿って並べ直す"
          }
        }
      }
    },
    "arrange.byLinesHelp" : {
      "comment" : "Hover help of the Arrange by lines item.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rearranges the whole map along its lines (inside the selected group only, if one is selected): referenced shapes to the left, what is called, read or written to the right"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "線に沿って図全体を並べ直します（グループを選んでいればその中だけ）。参照される形は左、呼ぶ・読む・書く先は右に置きます"
          }
        }
      }
    },
    "arrange.help" : {
      "comment" : "Hover help of the Arrange button on the diagram band.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidy or rearrange the map"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "図を整える・並べ直す"
          }
        }
      }
    },
    "arrange.tidy" : {
      "comment" : "Item of the Arrange menu on the diagram band and of the Edit menu that moves boxes down only, to clear overlaps.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tidy"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整える"
          }
        }
      }
    },
    "arrange.tidyHelp" : {
      "comment" : "Hover help of the Tidy item.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keeps every card where it is and only moves cards down to clear overlaps and leave room for rows that open"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カードの位置はそのままで、重なりと、行を開いて伸びる分だけ下へずらします"
          }
        }
      }
    },
    "arrange.title" : {
      "comment" : "Button on the diagram band, left of Filter, that opens the menu of Tidy and Arrange by lines.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrange"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整列"
          }
        }
      }
    },
    "ask.cut" : {
      "comment" : "Title of the confirmation for discarding old history; arguments are the number of commits, the commit number and the size saved.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Discard the %lld commit before commit #%@ (the history shrinks by %@)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Discard the %lld commits before commit #%@ (the history shrinks by %@)"
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コミット #%2$@ より前の %1$lld 件を捨てます（履歴が %3$@ 減ります）"
          }
        }
      }
    },
    "ask.cutMessage" : {
      "comment" : "Message of the confirmation for discarding old history.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will not be able to go back to before the discarded commits. Merges and inspections stay as they are."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "捨てた所より前には戻せなくなります。merge とインスペクションは変わりません"
          }
        }
      }
    },
    "ask.revertBranch" : {
      "comment" : "Title of the revert confirmation on a branch; arguments are the number of newer commits and the commit number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Undo the newest %lld commit by going back to just after commit #%@"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Undo the newest %lld commits by going back to just after commit #%@"
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コミット #%2$@ のすぐあとまで戻します（新しい %1$lld 件を取り消します）"
          }
        }
      }
    },
    "ask.revertMain" : {
      "comment" : "Title of the revert confirmation on main; arguments are the number of newer commits and the commit number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Create a branch with the newest %lld commit undone: main as it was just after commit #%@ (main itself stays as it is; you merge it in)"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Create a branch with the newest %lld commits undone: main as it was just after commit #%@ (main itself stays as it is; you merge it in)"
                }
              }
            }
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コミット #%2$@ のすぐあとの main を branch に作ります（新しい %1$lld 件を取り消した形。main はそのままで、merge で入れます）"
          }
        }
      }
    },
    "ask.revertMessage" : {
      "comment" : "Message of the revert confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The undone changes stay as a “Revert” commit, and going back to the one before it undoes the revert too."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り消したことは「戻す」のコミットとして残り、その前を選べば戻したことも戻せます"
          }
        }
      }
    },
    "ask.undoBranch" : {
      "comment" : "Title of the undo-one-commit confirmation on a branch or the board; the argument is the commit number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Undo only the changes of commit #%@ (the changes of later commits stay)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コミット #%@ の変更だけを取り消します（あとのコミットの変更は残します）"
          }
        }
      }
    },
    "ask.undoMain" : {
      "comment" : "Title of the undo-one-commit confirmation on main; the argument is the commit number.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Create a branch with only the changes of commit #%@ undone (main itself stays as it is; you merge it in)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コミット #%@ の変更だけを取り消した形の branch を作ります（main はそのままで、merge で入れます）"
          }
        }
      }
    },
    "ask.undoMessage" : {
      "comment" : "Message of the undo-one-commit confirmation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The undo stays as a “Revert” commit, and that can be undone too. If a later commit changed the same place, nothing is written and that place is shown."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "取り消したことは「戻す」のコミットとして残り、それも取り消せます。あとのコミットも同じ所を変えていれば、何も書かずにその所を見せます"
          }
        }
      }
    },
