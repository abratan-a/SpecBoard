    "help.partnerNotWritten" : {
      "comment" : "Under a receiving begin's partners while it names none and takes no caller: a gap.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partner not written — add a partner or a program, or check Anyone"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手が書かれていない — 相手か program を足すか、誰からでもを入れる"
          }
        }
      }
    },
    "help.peerReceive" : {
      "comment" : "Help beside the peer key of a begin node that receives.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flows that send it (as many as needed; may be combined with a program). Leaving both peer and program out is a gap (partner not written); if any caller may call it, check Anyone below"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送ってくる flow（何本でも。program と一緒にも書ける）。peer も program も省くのは穴（相手が書かれていない）。呼び手を問わないなら下の「誰からでも」"
          }
        }
      }
    },
    "help.peerReturn" : {
      "comment" : "Help beside the peer key of an end node's return.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flows it returns to (as many as needed; may be combined with a program). Leave both peer and program out to return to the one the start receives from"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返す先の flow（何本でも。program と一緒にも書ける）。peer も program も省くと開始が受ける相手へ"
          }
        }
      }
    },
    "help.return" : {
      "comment" : "Help beside the return of an end node.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What it gives back to the one the start receives from (or to the peer or program). An end that gives nothing back leaves it out"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "開始が受ける相手（か peer・program の相手）へ返すもの。返さない終了は書かない"
          }
        }
      }
    },
    "help.row" : {
